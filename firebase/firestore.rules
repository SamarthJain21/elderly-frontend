rules_version = '2';

// Client access only. The backend uses the Admin SDK, which bypasses these rules,
// so every collection is read-only for clients unless a write is listed below.
// Anything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function elder(elderId) {
      return get(/databases/$(database)/documents/elders/$(elderId)).data;
    }

    function isElder(elderId) {
      return signedIn() && request.auth.uid == elderId;
    }

    function isCaretakerOf(elderId) {
      return signedIn()
        && role() == 'caretaker'
        && request.auth.uid in elder(elderId).caretakerIds;
    }

    // Tier ladder: alerts_only < daily_summary < full_access.
    function caretakerTierAtLeast(elderId, minTier) {
      let tier = elder(elderId).sharingTier;
      return isCaretakerOf(elderId) && (
        minTier == 'alerts_only'
        || (minTier == 'daily_summary' && tier in ['daily_summary', 'full_access'])
        || (minTier == 'full_access' && tier == 'full_access')
      );
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- identity ----------

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /caretakers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /elders/{elderId} {
      allow read: if isElder(elderId) || isCaretakerOf(elderId);
      // Caretakers edit the profile, never membership or identity fields.
      allow update: if isCaretakerOf(elderId)
        && onlyChanges(['name', 'phone', 'language', 'medicationSchedule',
                        'emergencyContacts', 'sharingTier'])
        && request.resource.data.sharingTier in ['alerts_only', 'daily_summary', 'full_access'];
    }

    // Emergency alerts (SOS button / agent): the elder and every caretaker, at every sharing tier.
    match /elders/{elderId}/alerts/{alertId} {
      allow read: if isElder(elderId) || isCaretakerOf(elderId);
    }

    // Family chat (elder ↔ caretakers): every caretaker of the elder, at every tier — it's their own thread.
    // Writes go through the backend so reply suggestions and live delivery happen.
    match /elders/{elderId}/family_messages/{msgId} {
      allow read: if isElder(elderId) || isCaretakerOf(elderId);
    }

    // Chat with the agent. Conversations are the most private data: full_access caretakers only.
    match /elders/{elderId}/messages/{msgId} {
      allow read: if isElder(elderId) || caretakerTierAtLeast(elderId, 'full_access');
    }

    // ---------- wellness data (tiered) ----------

    match /check_ins/{id} {
      allow read: if isElder(resource.data.elderId)
        || caretakerTierAtLeast(resource.data.elderId, 'daily_summary');
    }

    // Raw transcripts live apart from check_ins because rules can't hide single fields.
    match /check_in_transcripts/{id} {
      allow read: if isElder(resource.data.elderId)
        || caretakerTierAtLeast(resource.data.elderId, 'full_access');
    }

    // Activity log lives under the elder (newest-first queries need no composite index).
    match /elders/{elderId}/logs/{id} {
      allow read: if isElder(elderId)
        || caretakerTierAtLeast(elderId, 'daily_summary')
        || (isCaretakerOf(elderId) && resource.data.kind == 'alert');
      // Caretakers may only acknowledge.
      allow update: if isCaretakerOf(elderId)
        && onlyChanges(['ack'])
        && request.resource.data.ack is bool;
    }

    // ---------- agent actions (all tiers: approvals can't wait on sharing level) ----------

    // Agent actions; an action's status doubles as its approval state. Readable at every tier
    // (approvals can't wait on sharing level). Decisions go through the backend API.
    match /elders/{elderId}/actions/{id} {
      allow read: if isElder(elderId) || isCaretakerOf(elderId);
    }

    // Contacts (family, neighbours, volunteers) and help requests: caretakers only — phone numbers
    // of third parties shouldn't reach the elder's device. Writes go through the API.
    match /elders/{elderId}/contacts/{id} {
      allow read: if isCaretakerOf(elderId);
    }

    match /elders/{elderId}/requests/{id} {
      allow read: if isCaretakerOf(elderId);
    }

    match /rules/{elderId} {
      allow read: if isElder(elderId) || isCaretakerOf(elderId);
      allow create, update: if isCaretakerOf(elderId) && validRules(request.resource.data);
    }

    function validMode(m) {
      return m in ['autonomous', 'elder_confirm', 'caretaker_approve', 'blocked'];
    }

    function validRules(r) {
      let t = r.tools;
      return r.currency in ['INR', 'SGD', 'THB']
        && t is map
        // Unknown tools rejected; emergency/weather/questions are fixed in code.
        && t.keys().hasOnly(['order_food', 'order_medicine', 'book_ride', 'notify_volunteer',
                             'send_message_to_caretaker', 'set_reminder'])
        && t.keys().hasAll(['order_food', 'order_medicine', 'book_ride'])
        && validMode(t.order_food.mode) && t.order_food.limitMinor is int && t.order_food.limitMinor >= 0
        && validMode(t.order_medicine.mode) && t.order_medicine.limitMinor is int && t.order_medicine.limitMinor >= 0
        && validMode(t.book_ride.mode) && t.book_ride.limitMinor is int && t.book_ride.limitMinor >= 0;
    }
  }
}
