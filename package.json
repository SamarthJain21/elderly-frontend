{
  "name": "elderly-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
